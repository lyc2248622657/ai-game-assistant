# 复制本文件为 .env 并填入真实配置
# DeepSeek API Key：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 本地向量化模型（首次运行自动下载到 MODELS/embeddings）
# 注意：fastembed 使用 bge-small-zh-v1.5（约 95MB）；bge-m3（约 2GB）需改用 sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 数据目录（相对路径按 backend/ 解析，与启动时的 CWD 无关）
CHROMA_DIR=data/chroma
SQLITE_PATH=data/sessions.db
GAMES_CONFIG=config/games.yaml
DOCUMENTS_DIR=data/documents

# 接口鉴权
# API_TOKEN 留空 = 首次启动自动生成到 app_data/.api_token
# 本机回环（127.0.0.1/::1）默认免令牌；一旦用 --host 0.0.0.0 / Docker 暴露，就必须带令牌
API_TOKEN=
# 置 0 表示"本机也要令牌"（远程桌面、多人共用同一台主机时用）
TRUST_LOOPBACK=1
# 同一来源每分钟允许的鉴权失败次数（超出返回 429）
AUTH_FAIL_LIMIT=10

# 日志级别
LOG_LEVEL=INFO
